# Database
DATABASE_URL=postgresql://leadpilot:leadpilot@localhost:5432/leadpilot

# Redis
REDIS_URL=redis://localhost:6379

# Auth
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_EXPIRES_IN=7d

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# GitHub Personal Access Token (create at https://github.com/settings/tokens)
# Required scopes: public_repo (public repos) or repo (private repos)
GITHUB_TOKEN=your-github-personal-access-token

# OpenAI
OPENAI_API_KEY=

# App
API_PORT=3001
WEB_PORT=3000
# Full URL of the frontend app. Used by the backend for CORS.
WEB_URL=http://localhost:3000
NODE_ENV=development

# Frontend (Next.js — NEXT_PUBLIC_ prefix required for browser exposure)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
